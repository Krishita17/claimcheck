{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ClaimCheck",
          "informationUri": "https://github.com/Krishita17/claimcheck",
          "version": "0.1.0",
          "rules": [
            {
              "id": "claimcheck/claimable-internal-name",
              "name": "ClaimableInternalName",
              "shortDescription": {
                "text": "Internal package name is claimable on the public registry"
              },
              "fullDescription": {
                "text": "An internal dependency name is unregistered on the public registry and the install configuration permits public fallback. An attacker could publish this name publicly and have it pulled into builds (dependency confusion)."
              },
              "helpUri": "https://github.com/Krishita17/claimcheck#remediation",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "claimcheck/taken-not-yours",
              "name": "TakenNotYours",
              "shortDescription": {
                "text": "Internal name already public and not owned by you"
              },
              "fullDescription": {
                "text": "An internal dependency name already exists on the public registry and is not owned by your organization \u2014 a possible existing squat. Investigate the owner and publish date."
              },
              "helpUri": "https://github.com/Krishita17/claimcheck#remediation",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "claimcheck/protected-internal-name",
              "name": "ProtectedInternalName",
              "shortDescription": {
                "text": "Internal name is unclaimed but protected by config"
              },
              "fullDescription": {
                "text": "An internal dependency name is unregistered publicly but the scope is reserved / index pinned, preventing public fallback. Re-scan in CI because a config change re-opens the exposure."
              },
              "helpUri": "https://github.com/Krishita17/claimcheck#remediation",
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "claimcheck/claimable-internal-name",
          "level": "error",
          "message": {
            "text": "CLAIMABLE: internal npm name 'acmecorp-config-loader'. Defensively register this name on the public registry now (a stub you control), and reserve the npm scope / pin the pip index so builds cannot fall back to public."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "samples/acme/Dockerfile"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "properties": {
            "priority": 1,
            "classification": "internal",
            "evidence": [
              "classification: internal (matches internal prefix 'acmecorp-')",
              "found in: samples/acme/Dockerfile:3 [Dockerfile]",
              "public registry: NOT FOUND (src=mock)",
              "fallback: unscoped name resolves against the default registry (public fallback possible)"
            ]
          }
        },
        {
          "ruleId": "claimcheck/taken-not-yours",
          "level": "warning",
          "message": {
            "text": "TAKEN-NOT-YOURS: internal npm name 'acmecorp-internal-logger'. Investigate: a public package with this name exists and is not yours (possible squat). Verify the owner and publish date; if malicious, report it to the registry and pin/replace the dependency."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "samples/acme/.github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ],
          "properties": {
            "priority": 1,
            "classification": "internal",
            "evidence": [
              "classification: internal (matches internal prefix 'acmecorp-')",
              "found in: samples/acme/.github/workflows/ci.yml:8 [ci]",
              "public registry: EXISTS (owner=mallory, first_published=2026-09-20, recent=True, src=mock)",
              "fallback: unscoped name resolves against the default registry (public fallback possible)"
            ]
          }
        },
        {
          "ruleId": "claimcheck/claimable-internal-name",
          "level": "error",
          "message": {
