%% ClaimCheck architecture (Mermaid source).
%% Rendered PNG: figures/architecture.png (generated by experiments/make_figures.py).
flowchart TD
    IN[["Input: repo / manifests / configs"]]

    subgraph COLLECT [Discovery]
        C[Source collectors<br/>manifests, lockfiles,<br/>.npmrc / pip.conf, CI, Dockerfile]
        E[Name extractor + normalizer<br/>dedup, tag ecosystem+scope,<br/>PEP 503 canonicalization]
    end

    CL[Internal / external classifier<br/>scope prefixes, org config,<br/>allowlist, not-on-public heuristic]

    subgraph EVIDENCE [Evidence gathering]
        R[Read-only registry probe<br/>PyPI + npm: exists? owner? when?]
        F[Scope / config fallback analyzer<br/>reserved scope? pinned index?<br/>public fallback possible?]
    end

    SCORE{{Exposure scorer + verdict engine<br/>CLAIMABLE / TAKEN-NOT-YOURS /<br/>PROTECTED / SAFE}}

    REP[Exposure report generator<br/>prioritized list + per-name action<br/>text / JSON / SARIF]

    IN --> C --> E --> CL
    CL --> R
    CL --> F
    CL --> SCORE
    R --> SCORE
    F --> SCORE
    SCORE --> REP
